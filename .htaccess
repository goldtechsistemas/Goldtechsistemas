# Cache do site Gold Tech Sistemas
# Pagina (HTML) e arquivos de texto: o navegador sempre confere se mudou antes de usar a copia guardada.
# Imagens e icones: o navegador guarda por 7 dias. Fontes: 1 ano (o arquivo de fonte nunca muda de conteudo).
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html?|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
